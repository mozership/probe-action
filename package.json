{
  "name": "probe-action",
  "version": "1.4.1",
  "private": true,
  "description": "GitHub Action that runs probe workflows",
  "author": "mozership",
  "license": "MIT",
  "main": "dist/index.js",
  "scripts": {
    "build": "ncc build src/main.ts -o dist --source-map --license licenses.txt",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "vitest run",
    "all": "npm run lint && npm run typecheck && npm run test && npm run build"
  },
  "dependencies": {
    "@actions/cache": "^6.3.0",
    "@actions/core": "^3.0.1",
    "@actions/exec": "^3.0.0",
    "@actions/tool-cache": "^4.0.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.9",
    "@types/node": "^24.19.4",
    "@vercel/ncc": "^0.45.0",
    "typescript": "^6.0.3",
    "vitest": "^5.1.2"
  },
  "overrides": {
    "minimatch": "10.2.6",
    "brace-expansion": "5.1.0"
  }
}
